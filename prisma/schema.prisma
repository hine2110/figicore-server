model livestream_products {
  id               Int              @id @default(autoincrement())
  livestream_id    Int
  variant_id       Int
  live_price       Decimal?         @db.Decimal(15, 2)
  flash_sale_price Decimal?         @db.Decimal(15, 2)
  flash_sale_stock Int?             @default(0)
