model salary_change_histories {
  history_id     Int       @id @default(autoincrement())
  user_id        Int
  changed_by_id  Int?
  old_salary     Decimal   @db.Decimal(15, 2)
  new_salary     Decimal   @db.Decimal(15, 2)
