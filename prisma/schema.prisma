model timesheet_corrections {
  correction_id Int        @id @default(autoincrement())
  timesheet_id  Int
  user_id       Int
  reason        String
  evidence_url  String?
  status_code   String?    @default("PENDING") @db.VarChar(50)
  manager_note  String?
  reviewer_id   Int?
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  updated_at    DateTime?  @default(now()) @db.Timestamp(6)
