// ----------------------------------------------------------------------------
// PII SECURITY — Audit Access Log
// ----------------------------------------------------------------------------

model pii_access_logs {
  log_id          Int      @id @default(autoincrement())
  accessed_by     Int      // employee/admin user_id who viewed the data
  target_user_id  Int      // customer user_id whose data was viewed
  fields_viewed   String   @db.VarChar(255) // e.g. "phone,email,address"
  ip_address      String?  @db.VarChar(45)
  accessed_at     DateTime @default(now()) @db.Timestamp(6)

  accessor        users    @relation("PiiAccessor", fields: [accessed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  target          users    @relation("PiiTarget", fields: [target_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([accessed_by], map: "idx_pii_log_accessor")
  @@index([target_user_id], map: "idx_pii_log_target")
  @@index([accessed_at], map: "idx_pii_log_time")
}

model inventory_recommendations {
  id                     Int                  @id @default(autoincrement())
  variant_id             Int
  type                   RecommendationType
  reason                 String
  suggested_action_value String?              @db.VarChar(255)
  status                 RecommendationStatus @default(PENDING)
  created_at             DateTime             @default(now()) @db.Timestamp(6)
  updated_at             DateTime             @default(now()) @db.Timestamp(6)
  financial_note         String?
  product_variants       product_variants     @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade)

  @@index([variant_id, status], map: "idx_recommendations_lookup")
}

model system_settings {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
}

model system_settings_logs {
  id         Int      @id @default(autoincrement())
  key        String   @db.VarChar(100)
  old_value  Json?
  new_value  Json?
  user_id    Int
  created_at DateTime @default(now()) @db.Timestamp(6)
}

enum VoucherStatus {
  COLLECTED
  USED
  EXPIRED
}

enum RecommendationType {
  CLEARANCE
  RESTOCK
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}
